.DS_Store
.env
.venv/
.uv-cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.egg-info/
*.py[cod]
build/
dist/

# Inputs and generated artifacts are not committed by default.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
results/manifests/*.json
results/metrics/*
!results/metrics/.gitkeep
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.pdf
